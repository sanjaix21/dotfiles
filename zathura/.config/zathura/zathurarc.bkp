set statusbar-h-padding 0
set statusbar-v-padding 0
map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map r reload
map R rotate
map K zoom in
map J zoom out
map i recolor
map p print
set selection-clipboard clipboard
map k scroll half-up
map j scroll half-down
map m toggle_statusbar
set default-bg "#00FFFFFF"
set statusbar-bg "#2205FF"
set statusbar-fg "#FFFFFF"
set selection-notification true

set synctex-editor-command "zathura_slp %p"
set page $(cat ~/.config/zathura/last_page)


